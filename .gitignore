# 機密情報・認証情報 — 絶対にコミットしない
.env
.env.*
*.key
*.pem
secrets/
credentials/
*_secret*
*apikey*
*api_key*

# 顧客提供の生データ（必要に応じて除外）
clients/**/raw-data/
clients/**/*.confidential.*

# OS / エディタ
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# 一時ファイル
*.tmp
*.log
node_modules/
__pycache__/
.venv/
venv/

# Office 一時ファイル
~$*.docx
~$*.xlsx
~$*.pptx

# OCRツールの出力
tools/ocr/out/
tools/ocr/*.csv
tools/ocr/__pycache__/
